# Managed by Ansible until k3s ships containerd PR 14487.
# This is the k3s-io/containerd v2.3.7-k3s1 default profile plus the two
# stacked-peer rules. Remove the file when the runtime profile carries the fix.
abi <abi/3.0>,

#include <tunables/global>

profile {{ cri_apparmor_profile_name }} flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes.
  signal (receive) peer=runc,
  # crun may send signals to container processes.
  signal (receive) peer=crun,
  # Manager may send signals to container processes.
  signal (receive) peer={{ cri_apparmor_daemon_profile }},
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer={{ cri_apparmor_profile_name }},

  # Ubuntu kernels 7.0.0-42 and later stack this profile with unconfined.
  # Without these two rules, processes in one container cannot signal each other.
  signal (send,receive) peer={{ cri_apparmor_profile_name }}//&unconfined,
  ptrace (trace,tracedby,read,readby) peer={{ cri_apparmor_profile_name }}//&unconfined,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer={{ cri_apparmor_profile_name }},
}
